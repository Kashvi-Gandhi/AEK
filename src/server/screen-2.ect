<<
@configure
  connected: true
  scripts:[
    "screen-2"
  ]
>>

<< extend "templates/master.ect" >>

<< content "body" >>

  {% set utils = aek.extension("CMAuthUtilities") %}
  {% set attrs = utils.getTokenAttributes() %}

  <script>
    window.userDetails = {{ attrs|json_encode|raw }};
  </script>

<< end >>