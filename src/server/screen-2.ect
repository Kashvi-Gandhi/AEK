<<
@configure
  connected: true
  auth: true
  scripts:[
    "screen"
  ]
>>

<< extend "templates/master.ect" >>

<< content "body" >>

  <% utils = @aek.extension("CMAuthUtilities") %>
  <% attrs = utils.getTokenAttributes() if utils %>

  <script>
    window.userDetails = <%- JSON.stringify(attrs || {}) %>;

    console.log("====================================");
    console.log("CMAuth Token Attributes:", window.userDetails);
    console.log("====================================");
  </script>

<< end >>