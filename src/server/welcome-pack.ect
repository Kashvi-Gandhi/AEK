#}


















<<
@configure
  connected: true
  scripts:[
    "welcome-pack"
  ]
>>

<< block 'init': >>

  {% set utils = aek.extension("CMAuthUtilities") %}
  {% set attrs = utils.getTokenAttributes() %}
  {% set extra = utils.getExtraAttributes() %}

  {% set username = attrs.username %}


  {#
    -------------------------------------------------------
    Azure Function
    -------------------------------------------------------
  #}

  {% set azureFunctionBase =
    "https://aek-sharepoint-doc-fetch-bngdcsdwavdqf9gm.uksouth-01.azurewebsites.net/api"
  %}


  {#
    -------------------------------------------------------
    1. Get Participant Type / Campus
    -------------------------------------------------------
  #}

  {% if aek.action == "getParticipantType" %}

    {#
      Contact ID comes directly from CMAuth.
      attrs.username was already confirmed to work.
    #}

    {% set contactId = username %}

    {% set service =
      aek.create_service(
        azureFunctionBase ~
        "/welcome-pack/user-details?contactID=" ~ contactId
      )
    %}

    {{ service.set_method("GET") }}

    {{ aek.respond(service.json) }}

  {% endif %}


  {#
    -------------------------------------------------------
    2. Get Welcome Pack information
    -------------------------------------------------------
  #}

  {% if aek.action == "getWelcomePackInfo" %}

    {% set campus = "Rome" %}
    {% set documentType = "Welcome Pack" %}

    {% set service =
      aek.create_service(
        azureFunctionBase ~
        "/welcome-pack/info?campus=" ~ campus ~
        "&documentType=" ~ documentType
      )
    %}

    {{ service.set_method("GET") }}

    {{ aek.respond(service.json) }}

  {% endif %}


  {#
    -------------------------------------------------------
    3. Get Welcome Pack PDF
    -------------------------------------------------------
  #}

  {% if aek.action == "getWelcomePackContent" %}

    {% set campus = "Rome" %}
    {% set documentType = "Welcome Pack" %}

    {% set service =
      aek.create_service(
        azureFunctionBase ~
        "/welcome-pack/content?campus=" ~ campus ~
        "&documentType=" ~ documentType
      )
    %}

    {{ service.set_method("GET") }}

    {{ aek.respond(service.body) }}

  {% endif %}

<< end >>


<< extend "templates/master.ect" >>

<< block 'body': >>

  <script>
    window.contactid = "{{username}}";
  </script>

<< end >>