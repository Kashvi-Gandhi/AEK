<<
@configure
  connected: true
  auth: true
  scripts:[
    "screen-2"
  ]
>>
 
<< extend "templates/master.ect" >>
 
<< content "body" >>
 
  <<
    utils = aek.extension("CMAuthUtilities")
    attrs = if utils then utils.getTokenAttributes() else null
 
    if not attrs and aek.request?.cookies?.cmAuthToken
      token = aek.request.cookies.cmAuthToken
      parts = token.split('.')
      if parts.length is 3
        try
          b64 = parts[1].replace(/-/g, '+').replace(/_/g, '/')
          jsonStr = Buffer.from(b64, 'base64').toString('utf-8')
          attrs = JSON.parse(jsonStr)
        catch err
          console.log("Failed to parse JWT cookie", err)
 
    isGuest = not (attrs and attrs.username)
>>
 
  <script>
    window.userDetails = <%- JSON.stringify(attrs or {}) %>;
    window.isGuest = <%- if isGuest then 'true' else 'false' %>;
    console.log("DEBUG attrs:", window.userDetails);
</script>
 
<< end >>