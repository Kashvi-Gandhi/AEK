<<
@configure
  scripts:[
    "user-details"
  ]
>>

<< extend "templates/master.ect" >>

<< content "body" >>

  {% set utils = aek.extension("CMAuthUtilities") %}
 
{% set attrs = utils.getTokenAttributes() %}
{% set extra = utils.getExtraAttributes() %}
 
<div>
<h3>Token Attributes</h3>
<pre>{{ attrs|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
 
    <h3>Extra Attributes</h3>
<pre>{{ extra|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
</div>

<< end >>