<<
@configure
  scripts:[
    "user-details"
  ]
>>

<%
  utils = @aek.extension("CMAuthUtilities")
  attrs = utils.getTokenAttributes() if utils
%>

<html>
  <body>
    <h1>CMAuth Test</h1>

    <p>CMAuthUtilities exists:</p>
    <pre><%- JSON.stringify(!!utils) %></pre>

    <p>Attributes:</p>
    <pre><%- JSON.stringify(attrs || {}) %></pre>
  </body>
</html>