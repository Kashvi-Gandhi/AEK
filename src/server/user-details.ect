<<
  @configure
    connected: true
    scripts:[
      "user-details"
    ]
    
  displayMessage = "Server ect data SUCCESSFUL xyz";
  secondMessage = "server second message";

>>

<< block 'init': >>

  {% set utils = aek.extension("CMAuthUtilities") %}
  {% set attrs = utils.getTokenAttributes() %}
  {% set extra = utils.getExtraAttributes() %}

  {% set twigVar1 = "ECT text twig variable 1" %}
  {% set twigVar2 = "ECT text twig variable 2" %}
  {% set username = attrs|get_item("username") %}

<< end >>

<< extend "templates/master.ect" >>

<< block 'body': >>

  <script>
    console.log("ect script added")

    window.userTextData = 
    { 
      tokenAttributes: "<<= JSON.stringify(displayMessage) >>",
      extraAttributes: "<<= secondMessage >>"
    };

    console.log("Text Attributes:", window.userTextData.tokenAttributes);

    window.userDetailsData = {
       tokenAttributes: {{ attrs|json_encode|raw }},
       extraAttributes: {{ extra|json_encode|raw }}
   };

   window.userName = {{username}};
   console.log("Username:" window.username);

    console.log("Token Attributes:", window.userDetailsData.tokenAttributes);

    window.userData = "{{twigVar1}}";
    console.log("twig data:", window.userData);


   console.log("Token Attributes:", window.userData.tokenAttributes);

  </script>

<< end >>

